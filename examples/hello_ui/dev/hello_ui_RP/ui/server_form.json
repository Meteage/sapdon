{
  "namespace": "server_form",
  "form_button@common_buttons.light_text_button": {
    "$pressed_button_name": "button.form_button_click",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": [
      16,
      16
    ],
    "$button_text": "#form_button_text",
    "$button_text_binding_type": "collection",
    "$button_text_grid_collection_name": "form_buttons",
    "$button_text_max_size": [
      "100%",
      20
    ],
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      }
    ]
  },
  "sapdon_form_button_grid": {
    "type": "grid",
    "size": [
      128,
      128
    ],
    "grid_dimensions": [
      8,
      8
    ],
    //"grid_item_template": "server_form.form_button",//全部显示，不设置是部分显示zcontrols里
    "collection_name": "form_buttons", //绑定表单1按钮数据
    "controls": [
      {
        "pos_wrap": {
          "type": "panel",
          "grid_position": [
            2,
            0
          ], // 放哪格，由 grid 负责
          "size": [
            0,
            0
          ], // 零尺寸，按钮自己溢出定位
          "anchor_from": "top_left",
          "anchor_to": "top_left", // 锚定格子左上角，offset 才从该点算起
          "controls": [
            {
              "apple_2@server_form.form_button": {
                "offset": [
                  100,
                  100
                ] // 放到 panel 内部 → offset 生效
                ,
                "size":[32,32]
              }
            }
          ]
        }
      },
      {
        "apple_2@server_form.form_button": {
          "grid_position": [
            0,
            1
          ]
        }
      },
      {
        "apple_1@server_form.form_button": {
          "grid_position": [
            0,
            2
          ]
        }
      },
      {
        "apple_2@server_form.form_button": {
          "grid_position": [
            0,
            3
          ]
        }
      }
    ]
  },
  "sapdon_buttons_panel": {
    "type": "panel",
    "size": [
      "60%",
      "60%"
    ],
    "controls": [
      {
        "debug_board": {
          "type": "image",
          "texture": "textures/ui/focus_border_white",
          "nineslice_size": 1,
          "size": [
            "100%",
            "100%"
          ]
        }
      },
      {
        "test_grid@sapdon_form_button_grid": {}
      }
    ]
  },
  //屏幕
  "third_party_server_screen@common.base_screen": {
    "type": "screen",
    "button_mappings": [
      {
        "from_button_id": "button.menu_cancel",
        "to_button_id": "button.menu_exit",
        "mapping_type": "global"
      }
    ],
    "$screen_content": "server_form.custom_full_screen"
  },
  //做分离
  "custom_full_screen": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "controls": [
      {
        "native_form@server_form.main_screen_content": {
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "((#title_text - 'sapdon_ui:') = #title_text)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "sapdon_custom_full@server_form.sapdon_screen_content": {}
      }
    ]
  },
  "custom_panel_content": {
    "type": "panel",
    "size": ["100%", "100%"],
    "bindings": [
      { "binding_name": "#title_text" },
      { "binding_type": "view", "source_property_name": "(#title_text = $panel_id)", "target_property_name": "#visible" }
    ],
    "controls": [
      { "content@$user_content_panel": {} },
      { "buttons@$user_buttons_panel": {} }
    ]
  },
  "sapdon_screen_content": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "bindings": [
      {
        "binding_name": "#title_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#title_text - 'sapdon_ui:') = #title_text))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      //sapdon界面注册入口
      {
        "custom@server_form.custom_panel_content": {
          "$panel_id": "sapdon_ui:test_ui",
          "$user_content_panel": "sapdon_ui_test_ui.test_ui_content_panel",
          "$user_buttons_panel": "sapdon_ui_test_ui.test_ui_buttons_panel"
        }
      },
      {
        "test@server_form.custom_panel_content": {
          "$panel_id": "sapdon_ui:test",
          "$user_content_panel": "sapdon_ui_test.test_content_panel",
          "$user_buttons_panel": "server_form.sapdon_buttons_panel"
        }
      }
    ]
  }
}