{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "sapdon:color_particle",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "variable.psize = 1;"
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 1,
				"max_particles": 1
			},
			"minecraft:emitter_lifetime_once": {},
			"minecraft:emitter_shape_point": {},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "variable.lifetime"
			},
			"minecraft:particle_initial_speed": 0,
			"minecraft:particle_appearance_billboard": {
				"size": ["0.12 * variable.psize", "0.12 * variable.psize"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": [49, 88],
					"uv_size": [8, 8]
				},
				"rotation": "variable.spin * variable.particle_age"
			},
			"minecraft:particle_appearance_tinting": {
				"color": ["variable.color_r", "variable.color_g", "variable.color_b", "math.sin(3.14159 * variable.particle_age / variable.particle_lifetime)"]
			}
		}
	}
}
